&dsi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	panel1@0 {
		compatible = "ft8725,fhdp,dsi,vdo,txd,boe,144hz,lj7";
		reg = <0>;
		doze_backlight = <3 5 6 24>;
		reset-gpios = <&pio 90 0>;
		bias-gpios = <&pio 45 0>, <&pio 41 0>;
		vio18-supply = <&mt6369_vtp>;
		pinctrl-names = "default";
		port {
			panel_in1: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	ports {
		port {
			dsi_out: endpoint {
				remote-endpoint = <&panel_in1>;
			};
		};
	};
};
&audio_sram {
	reg = <0 0x11059000 0 0xc000>;
	mode-size = <0xc000 0x11300>;
};

&audio_xhci_sram {
	reg = <0 0x11065000 0 0x3900>;
	mode-size = <0x3900>;
	afe-reserved;
};

/* usb typec mux start */
&mt6375_typec {
	//tcpc,en-fod;
	pd-data {
		/*
		 * Fixed 5V, 500 mA <0x00019032>
		 * Fixed 5V, 1A <0x00019064>
		 * Fixed 5V, 1.5A <0x00019096>
		 * Fixed 5V, 2A <0x000190c8>
		 * Fixed 5V, 3A <0x0001912c>
		 * Fixed 9V, 500 mA <0x0002d032>
		 * Fixed 9V, 1A <0x0002d064>
		 * Fixed 9V, 2A <0x0002d0c8>
		 * Fixed 9V, 3A <0x0002d12c>
		 * Variable 5-9V, 1A <0x8642d064>
		 * Variable 5-9V, 2A <0x8642d0c8>
		 * Variable 5-9V, 3A <0x8642d12c>
		 * PPS 3V~5.9V, 3A <0xC0761E3C>
		 */
		pd,source-pdo-size = <2>;
		pd,source-pdo-data = <0x00019032 0x000190c8>; /* 1:5V,500mA  2:5V,2000 mA */
	};
};

&pdc {
	pd-vbus-upper-bound = <9000000>;
};

&irtx_pwm {
	pwm_ch = <0>;
	status = "okay";
};

&consys {
	hwid-node = <92>;
	adie-sku = <1 0>;
};

&thermal_zones {
	sub_ntc: sub_ntc {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&tboard_thermistor4>;

		trips {
			sub_ntc_crit: sub-ntc-crit {
				temperature = <119000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};
	tran_one_ntc: tran_one_ntc {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&tboard_thermistor5>;

		trips {
			tran_one_ntc_crit: tran-one-ntc-crit {
				temperature = <119000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};
	tran_two_ntc: tran_two_ntc {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&tboard_thermistor6>;

		trips {
			tran_two_ntc_crit: tran-two-ntc-crit {
				temperature = <119000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};
};

&u2port0 {
        mediatek,eye-vrt = <0x6>;
        mediatek,eye-term = <0x7>;
        mediatek,rev6 = <0x2>;
        mediatek,eye-vrt-host = <0x6>;
        mediatek,eye-term-host = <0x7>;
        mediatek,rev6-host = <0x2>;
};

