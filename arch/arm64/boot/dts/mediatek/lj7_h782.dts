/dts-v1/;
/plugin/;
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/pinctrl/mt6878-pinfunc.h>
#include <dt-bindings/iio/mt635x-auxadc.h> 
#if 0
#include <dt-bindings/pinctrl/mt6897-pinfunc.h>
#endif

&chosen {
bootargs_ext = "";
};

&pdc {
	pd-vbus-upper-bound = <9000000>;
};

#if 1

&connfem {
/* Enable epa_elna node to support Wifi & BT ePA/eLNA FEM on customer load */
#if 0
	epa-elna {
		parts = <&wlan7207h &wlan7207c>;
		wifi {
			flags-0 {
				open-loop;
			};
		};
		bt {
			flags-0 {
				/* choose one of: epa-elna/epa/elna/bypass */
				epa-elna;
			};
		};
	};
#endif
};

/* GPS GPIO standardization start */
&pio {
	gps_pins_default: gps-default {
	};
	gps_l1_lna_pins_ol: gps-l1-lna@0 {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO181__FUNC_GPIO181>;
			output-low;
		};
	};
	gps_l1_lna_pins_dsp_ctrl: gps-l1-lna@1 {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO181__FUNC_GPS_L1_ELNA_EN>;
		};
	};
	gps_l1_lna_pins_oh: gps-l1-lna@2 {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO181__FUNC_GPIO181>;
			output-high;
		};
	};
};
&gps {
	pinctrl-names = "default",
		"gps_l1_lna_disable",
		"gps_l1_lna_dsp_ctrl",
		"gps_l1_lna_enable";
	pinctrl-0 = <&gps_pins_default>;
	pinctrl-1 = <&gps_l1_lna_pins_ol>;
	pinctrl-2 = <&gps_l1_lna_pins_dsp_ctrl>;
	pinctrl-3 = <&gps_l1_lna_pins_oh>;
	status = "okay";
};
/* GPS GPIO standardization end */

#endif

&spi1 {
    fingerprint@0 {
        compatible = "tran_fp";
        reg = <0>;
        spi-max-frequency = <35000000>;
        interrupt-parent = <&pio>;
        interrupts = <13 1 13 0>;
        debounce = <27 0>;
        irq-gpio = <13>;
        irq-gpio-std = <&pio 13 0x0>;
        reset-gpio = <149>;
        reset-gpio-std = <&pio 149 0x0>;
        vmch-supply = <&mt6369_vfp>;
        fod_location_xy = "630,2537";
        pinctrl-names ="tran_fp_default",
            "tran_fp_pin_irq",
            "tran_fp_irq_pull_down",
            "tran_fp_reset_high",
            "tran_fp_reset_low",
            "tran_fp_spi_default";
        pinctrl-0 = <&fingerprint_default>;
        pinctrl-1 = <&fingerprint_eint>;
        pinctrl-2 = <&fingerprint_eint_pull_down>;
        pinctrl-3 = <&fingerprint_rst_one>;
        pinctrl-4 = <&fingerprint_rst_zero>;
        pinctrl-5 = <&fingerprint_spi_default>;
        status = "okay";
    };
};
&pio {
    fingerprint_default: fingerprint_default {
	};
    fingerprint_eint: gpio13_eint {
    pins_cmd_dat {
        pinmux = <PINMUX_GPIO13__FUNC_GPIO13>;
        slew-rate = <0>;
        bias-disable;
        };
    };
    fingerprint_eint_pull_down: gpio13_eint_pull_down {
    pins_cmd_dat {
        pinmux = <PINMUX_GPIO13__FUNC_GPIO13>;
        slew-rate = <0>;
        bias-pull-down = <00>;
        output-low;
        };
    };
    fingerprint_rst_one: rst_out_one {
    pins_cmd_dat {
        pinmux = <PINMUX_GPIO149__FUNC_GPIO149>;
        slew-rate = <1>;
        bias-disable;
        output-high;
        };
    };
    fingerprint_rst_zero: rst_out_zero {
    pins_cmd_dat {
        pinmux = <PINMUX_GPIO149__FUNC_GPIO149>;
        slew-rate = <1>;
        bias-disable;
        output-low;
        };
    };
    fingerprint_spi_default: spimode_default {
        pins_cmd_dat {
        pinmux = <PINMUX_GPIO61__FUNC_SPI1_CSB>,
                <PINMUX_GPIO60__FUNC_SPI1_CLK>,
                <PINMUX_GPIO63__FUNC_SPI1_MI>,
                <PINMUX_GPIO62__FUNC_SPI1_MO>;
                drive-strength = <7>;
         };
     };
};

&i2c10 {
	clock-frequency = <400000>;
	sec-nfc@27 {
		compatible = "sec-nfc";
		reg = <0x27>;
		sec-nfc,ven-gpio = <&pio 40 0x0>;
		sec-nfc,irq-gpio = <&pio 2 0x0>;
		sec-nfc,firm-gpio = <&pio 1 0x0>;
	};
};

/*
&i2c6 {
	spk: speaker-amp@5c {
		compatible = "richtek,rt5512";
		#address-cells = <1>;
		#size-cells = <0>;
		#sound-dai-cells = <0>;
		reg = <0x5c>;
		status = "okay";
		sound-name-prefix = "Left";
	};
};
&sound {
	mediatek,spk-i2s = <25 24>;
};
*/
&i2c3 {
	aw87xxx_pa@58 {
		compatible = "awinic,aw87xxx_pa";
		reg = <0x58>;
		dev_index = < 1 >;
		status = "okay";
	};
	aw87xxx_pa@59 {
		compatible = "awinic,aw87xxx_pa";
		reg = <0x59>;
		dev_index = < 0 >;
		status = "okay";
	};
};

&odm {
	tran_audio_controller:tran_audio_controller {
		compatible = "tran-audio-controller";
		tran_pa_type = <2>;
	};
	tran_audio:tran_audio {
		compatible = "tran_audio,audio";
		typec_usb_change_gpio = <&pio 189 0>;
	};
	tran_audio_sliptswitch {
		compatible = "transsion,sliptswitch-audioswitch";
	};
	tran_audio_sliptswitch_gpio {
		compatible = "transsion,sliptswitch-gpio-audioswitch";
		audio_usb_switch_dio32020 = <&pio 43 0>;
		mic_gnd_switch_dio1520 = <&pio 18 0>;
	};
