/********************************************
 * MT6897 TOUCH/VIBR/KEY DTSI File
 ********************************************/

&chosen {
lra,info = <1 7 22>;//type:(1:X-lra 2:Z-lra)  bus_num:i2c7  reset_gpio:gpio22
};

&mt6363keys {
	home {
		linux,keycodes = <114>;
	};
};

/* RT6010 Haptic start */
&i2c7 {
	ics_haptic@5f {
		compatible = "ics,haptic_rt";
		reg = <0x5f>;
		interrupt-parent = <&pio>;
		interrupts = <59 IRQ_TYPE_EDGE_FALLING 59 0>;
		device-name = "vibrator_single";
		richtap-name = "aac_richtap_5f";
		gpio-en = <&pio 22 0>;
		gpio-irq = <&pio 59 0>;
		status = "ok";
		// rt6010 chip configuration
		rt6010_chip_id = <0x6B>;
		rt6010_reg_size = <0x6C>;
		rt6010_ram_size = <0x600>;
		rt6010_sys_f0 = <1700>;
		rt6010_list_base_addr = <0x400>;
		rt6010_wave_base_addr = <0x420>;
		rt6010_fifo_ae = <0x200>;
		rt6010_fifo_af = <0x300>;
		rt6010_boost_mode = <0x00>;
		rt6010_boost_vol = <0x0A>;
		rt6010_gain = <0x80>;
		rt6010_brake_en = <0>;
		rt6010_brake_wave_no = <0>;
		rt6010_brake_const = <0>;
		rt6010_brake_acq_point = <0>;
	};
};
/* RT6010 Haptic end */

&hall_1 {
		hall_rlk,irq-gpio = <&pio 5 0x0>;
		interrupt-parent = <&pio>;
		interrupts = <5 IRQ_TYPE_LEVEL_LOW 5 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&hall_intpin_default>;
		status = "okay";
};
&pio {
	hall_intpin_default: halldefaultcfg {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO5__FUNC_GPIO5>;
			slew-rate = <0>;
			bias-pull-up = <00>;
			status = "okay";
		};
	};
};

&i2c10 {
	#address-cells = <1>;
	#size-cells = <0>;

	et5904@28 {
		compatible = "tran,et5904";
		reg = <0x28>;
		regulators {
			ET5904LDO110:ET5904LDO110 {
				regulator-name = "ET5904LDO110";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <1800000>;
			};
			ET5904LDO210:ET5904LDO210 {
				regulator-name = "ET5904LDO210";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <1800000>;
			};
			ET5904LDO310:ET5904LDO310 {
				regulator-name = "ET5904LDO310";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3300000>;
			};
			ET5904LDO410:ET5904LDO410 {
				regulator-name = "ET5904LDO410";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3300000>;
			};
		};
	};
};

&odm {
	main_touch: main_touch {
		compatible = "mediatek,touch-panel";
	};
};

&spi2 {
	main_touch@0 {
		 compatible = "focaltech,fts";
		 reg = <0>;
		 status = "ok";
		 spi-max-frequency = <8000000>;
		 interrupt-parent = <&pio>;

		 //For ft3683g  driver config
		 vtouch-supply = <&mt6368_vtp>;
		 focaltech,irq-gpio = <&pio 9 0x0>;
		 focaltech,reset-gpio = <&pio 60 0x0>;
		 focaltech,max-touch-number = <10>;
		 focaltech,display-coords =  <0 0 17279 38975>;
		 //focaltech,fod-function-support;
		 //focaltech,custom-mistouch-support;
	};
};
&spi4 {
	sub_touch@0 {
		 compatible = "goodix,marseille";
		 reg = <0>;
		 status = "ok";
		 spi-max-frequency = <8000000>;
		 interrupt-parent = <&pio>;

		 //For gt9615  driver config
		 goodix,avdd-name = "sub_vtouch";
		 sub_vtouch-supply = <&ET5904LDO410>;
		 //goodix,avdd-gpio = <&pio 81 0x0>;
		 goodix,iovdd-gpio = <&pio 187 0x0>;
		 goodix,reset-gpio = <&pio 61 0x0>;
		 goodix,irq-gpio = <&pio 10 0x0>;
		 goodix,irq-flags = <2>; /* 1:trigger rising, 2:trigger falling; */
		 goodix,panel-max-x = <1066>;
		 goodix,panel-max-y = <1056>;
		 goodix,panel-max-w = <255>;
		 /* optional properties */
		 goodix,panel-max-p = <4096>; /* max pressure that pen device supported */
		 //goodix,pen-enable; /* support active stylus device*/
		 goodix.sleep-enable; /* enter sleep mode */
		 goodix,firmware-name = "goodix_firmware.bin";
		 goodix,config-name = "goodix_cfg_group.bin";
		 pinctrl-names = "default","state_spi_mode";
		 pinctrl-0 = <&ctp_pins_default>;
		 pinctrl-1 = <&ctp_pins_spi_mode>;
	};
};

&pio {
	ctp_pins_default: ctp_default {
	};
	ctp_pins_spi_mode: ctp_spimode_default {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO38__FUNC_SPI4_MI>,
					 <PINMUX_GPIO37__FUNC_SPI4_CSB>,
					 <PINMUX_GPIO39__FUNC_SPI4_MO>,
					 <PINMUX_GPIO36__FUNC_SPI4_CLK>;
			drive-strength = <2>;
		};
	};
};
