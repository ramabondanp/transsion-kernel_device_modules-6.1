		pinctrl-3 = <&camera_pins_cam2_mclk_6ma>;
		pinctrl-4 = <&camera_pins_cam2_mclk_8ma>;
		pinctrl-5 = <&camera_pins_cam_mipi_switch2_en_1
				&camera_pins_cam_mipi_switch2_sel_1>;
		pinctrl-6 = <&camera_pins_cam_mipi_switch2_en_0
				&camera_pins_cam_mipi_switch2_sel_0>;

		rst-supply = <&gpioldo_rst2>;
		avdd-supply = <&ET5904LDO47>;
		dvdd-supply = <&ET5904LDO27>;
		dovdd-supply = <&mt6368_vrf18_aif>;

		clocks = <&topckgen_clk CLK_TOP_UNIVPLL_192M_D32>,
			<&topckgen_clk CLK_TOP_UNIVPLL_192M_D16>,
			<&topckgen_clk CLK_TOP_F26M_CK_D2>,
			<&topckgen_clk CLK_TOP_UNIVPLL_192M_D10>,
			<&topckgen_clk CLK_TOP_UNIVPLL_192M_D8>,
			<&topckgen_clk CLK_TOP_UNIVPLL_D6_D16>,
			<&topckgen_clk CLK_TOP_UNIVPLL_D6_D8>,
			<&topckgen_clk CLK_TOP_CAMTG3_SEL>;
		clock-names = "6", "12", "13", "19.2", "24", "26", "52", "mclk";

		status = "okay";

		port {
			sensor2_out: endpoint {
				remote-endpoint = <&seninf_csi_port_1_in>;
			};
		};
	};

	sensor4: sensor4@14 {
		compatible = "mediatek,imgsensor";
		sensor-names = "s5kjn5fake_mipi_raw";
		sensor-matecodes = "s5kjn5fake_17201948";
		reg = <0x14>;
		#thermal-sensor-cells = <0>;

		pinctrl-names = "mclk_off",
				"mclk_2mA",
				"mclk_4mA",
				"mclk_6mA",
				"mclk_8mA",
				"mipi_switch_off",
				"mipi_switch_on",
				"mipi_switch2_off",
				"mipi_switch2_on";
		pinctrl-0 = <&camera_pins_cam2_mclk_off>;
		pinctrl-1 = <&camera_pins_cam2_mclk_2ma>;
		pinctrl-2 = <&camera_pins_cam2_mclk_4ma>;
		pinctrl-3 = <&camera_pins_cam2_mclk_6ma>;
		pinctrl-4 = <&camera_pins_cam2_mclk_8ma>;
		pinctrl-5 = <&camera_pins_cam_mipi_switch_en_1
				&camera_pins_cam_mipi_switch_sel_1>;
		pinctrl-6 = <&camera_pins_cam_mipi_switch_en_0
				&camera_pins_cam_mipi_switch_sel_1>;
		pinctrl-7 = <&camera_pins_cam_mipi_switch2_en_1
				&camera_pins_cam_mipi_switch2_sel_1>;
		pinctrl-8 = <&camera_pins_cam_mipi_switch2_en_0
				&camera_pins_cam_mipi_switch2_sel_1>;

		rst-supply = <&gpioldo_rst2>;
		avdd-supply = <&ET5904LDO47>;
		dvdd-supply = <&ET5904LDO27>;
		dovdd-supply = <&mt6368_vrf18_aif>;

		clocks = <&topckgen_clk CLK_TOP_UNIVPLL_192M_D32>,
			<&topckgen_clk CLK_TOP_UNIVPLL_192M_D16>,
			<&topckgen_clk CLK_TOP_F26M_CK_D2>,
			<&topckgen_clk CLK_TOP_UNIVPLL_192M_D10>,
			<&topckgen_clk CLK_TOP_UNIVPLL_192M_D8>,
			<&topckgen_clk CLK_TOP_UNIVPLL_D6_D16>,
			<&topckgen_clk CLK_TOP_UNIVPLL_D6_D8>,
			<&topckgen_clk CLK_TOP_CAMTG3_SEL>;
		clock-names = "6", "12", "13", "19.2", "24", "26", "52", "mclk";

		status = "okay";

		port {
			sensor4_out: endpoint {
				remote-endpoint = <&seninf_csi_port_2_in2>;
			};
		};
	};

	mtk_camera_eeprom2:camera-eeprom2@50 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x50>;
		status = "okay";
	};

	mtk_camera_eeprom4:camera-eeprom4@54 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x54>;
		status = "okay";
	};
};

&i2c9 {
	status = "okay";
	clock-frequency = <1000000>;
	#address-cells = <1>;
