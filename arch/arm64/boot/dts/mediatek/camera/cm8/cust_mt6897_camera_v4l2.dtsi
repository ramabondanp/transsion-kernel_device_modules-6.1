            };
        };
   };
};

&odm {
    vs2pmu: vs2pmu {
      compatible = "regulator-fixed";
      regulator-name = "vs2pmu";
      regulator-min-microvolt = <1800000>;
      regulator-max-microvolt = <1800000>;
      gpio = <&pio 122 0x0>;
      enable-active-high;
      regulator-always-on;
      regulator-boot-on;
    };

    ldoid11: ldoid11 {
      compatible = "regulator-fixed";
      regulator-name = "ldoid11";
      regulator-min-microvolt = <1800000>;
      regulator-max-microvolt = <1800000>;
      gpio = <&pio 76 0x0>;
      enable-active-low;
      regulator-always-on;
      regulator-boot-on;
    };

    ldoid7: ldoid7 {
      compatible = "regulator-fixed";
      regulator-name = "ldoid7";
      regulator-min-microvolt = <1800000>;
      regulator-max-microvolt = <1800000>;
      gpio = <&pio 6 0x0>;
      enable-active-low;
      regulator-always-on;
      regulator-boot-on;
    };

    gpioldo_rst0: gpioldo_rst0 {
       compatible = "regulator-fixed";
       regulator-name = "gpioldo_rst0";
       regulator-min-microvolt = <1800000>;
       regulator-max-microvolt = <1800000>;
       gpio = <&pio 115 0x0>;
       enable-active-high;
    };

    gpioldo_rst1: gpioldo_rst1 {
       compatible = "regulator-fixed";
       regulator-name = "gpioldo_rst1";
       regulator-min-microvolt = <1800000>;
       regulator-max-microvolt = <1800000>;
       gpio = <&pio 116 0x0>;
       enable-active-high;
    };

    gpioldo_rst2: gpioldo_rst2 {
       compatible = "regulator-fixed";
       regulator-name = "gpioldo_rst2";
       regulator-min-microvolt = <1800000>;
       regulator-max-microvolt = <1800000>;
       gpio = <&pio 117 0x0>;
       enable-active-high;
    };
    gpioldo_rst3: gpioldo_rst3 {
       compatible = "regulator-fixed";
       regulator-name = "gpioldo_rst3";
       regulator-min-microvolt = <1800000>;
       regulator-max-microvolt = <1800000>;
       gpio = <&pio 118 0x0>;
       enable-active-high;
    };

    gpioldo_af1: gpioldo_af1 {
      compatible = "regulator-fixed";
      regulator-name = "gpioldo_af1";
      regulator-min-microvolt = <2800000>;
      regulator-max-microvolt = <2800000>;
      gpio = <&pio 73 0x0>;
      enable-active-high;
    };

    gpioldo_af2: gpioldo_af2 {
      compatible = "regulator-fixed";
      regulator-name = "gpioldo_af2";
      regulator-min-microvolt = <2800000>;
      regulator-max-microvolt = <2800000>;
      gpio = <&pio 72 0x0>;
      enable-active-high;
    };

    gpioldo_af3: gpioldo_af3 {
      compatible = "regulator-fixed";
      regulator-name = "gpioldo_af3";
      regulator-min-microvolt = <2800000>;
      regulator-max-microvolt = <2800000>;
      gpio = <&pio 120 0x0>;
      enable-active-high;
    };

};

&i2c6 {
	#address-cells = <1>;
	#size-cells = <0>;
	ocp81378:ocp81378@63 {
		compatible = "mediatek,ocp81378";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x63>;
		flashledno = <1>;
		#cooling-cells = <2>;
		pinctrl-names = "default", "hwen_high", "hwen_low";
		pinctrl-0 = <&ocp81378_pins_default>;
		pinctrl-1 = <&ocp81378_pins_hwen_high>;
		pinctrl-2 = <&ocp81378_pins_hwen_low>;
		status = "okay";
		flash@0{
			reg = <1>;
			type = <0>;
			ct = <0>;
			part = <0>;
			port {
				fl_core_0: endpoint {
					remote-endpoint = <&flashlight_0>;
				};
			};
		};
	};
};

&pio {
	ocp81378_pins_default: default {
	};
	ocp81378_pins_hwen_high: hwen-high {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO64__FUNC_GPIO64>;
			slew-rate = <1>;
			output-high;
		};
	};
	ocp81378_pins_hwen_low: hwen-low {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO64__FUNC_GPIO64>;
			slew-rate = <1>;
			output-low;
		};
	};
};

&mtk_composite_v4l2_1 {
	#address-cells = <1>;
	#size-cells = <0>;
	port@0 {
		reg = <0>;
		flashlight_0: endpoint {
			remote-endpoint = <&fl_core_0>;
		};
	};
};


&thermal_zones {
	camera0: camera0 {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&sensor0>;
		trips {
			camera0_crit: camera0-crit {
				temperature = <120000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};
	camera1: camera1 {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&sensor1>;
		trips {
			camera1_crit: camera1-crit {
				temperature = <120000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};
	camera2: camera2 {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&sensor2>;
		trips {
			camera2_crit: camera2-crit {
				temperature = <120000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};
	camera3: camera3 {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&sensor3>;
		trips {
			camera3_crit: camera3-crit {
				temperature = <120000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};
};

&mt6368_vio28 {
	/delete-property/regulator-always-on;
};

