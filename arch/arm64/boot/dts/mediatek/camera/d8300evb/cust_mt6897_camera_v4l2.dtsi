	status = "okay";
	clock-frequency = <1000000>;
	#address-cells = <1>;
	#size-cells = <0>;

	camera-af-main-three@c {
		compatible = "mediatek,main3_vcm";
		reg = <0x0b>;
		vin-supply = <&gpioldo_af3>;
		port {
			main_af_cam3: endpoint {
				remote-endpoint = <&main_af_cam3_endpoint>;
			};
		};
	};

	sensor3: sensor3@10 {
		compatible = "mediatek,imgsensor";
		sensor-names = "s5kjn1wide_mipi_raw";
		sensor-matecodes = "s5kjn1wide_17201852";
		reg = <0x10>;
		#thermal-sensor-cells = <0>;
		pinctrl-names = "mclk_off",
				"mclk_2mA",
				"mclk_4mA",
				"mclk_6mA",
