};

&pio {
	gpio_i2c_ldo_sclk_mode: i2c_ldo_sclk_mode {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO159__FUNC_SCL11>;
			drive-strength = <4>;
		};
	};

	gpio_i2c_ldo_sda_mode: i2c_ldo_sda_mode {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO160__FUNC_SDA11>;
			drive-strength = <4>;
		};
	};
};


&i2c11 {
    status = "okay";
    clock-frequency = <100000>;
    #address-cells = <1>;
    #size-cells = <0>;

    et5904@28 {
        compatible = "tran,et5904";
        pinctrl-names = "i2c_ldo_sclk_mode", "i2c_ldo_sda_mode";
        pinctrl-0 = <&gpio_i2c_ldo_sclk_mode>;
        pinctrl-1 = <&gpio_i2c_ldo_sda_mode>;
        reg = <0x28>;
        VIND-supply = <&vs2pmu>;
        regulators {
            ET5904LDO111:ET5904LDO111 {
                regulator-name = "ET5904LDO111";
                regulator-min-microvolt = <600000>;
                regulator-max-microvolt = <1800000>;
            };
            ET5904LDO211:ET5904LDO211 {
                regulator-name = "ET5904LDO211";
                regulator-min-microvolt = <600000>;
                regulator-max-microvolt = <1800000>;
            };
            ET5904LDO311:ET5904LDO311 {
                regulator-name = "ET5904LDO311";
                regulator-min-microvolt = <1200000>;
                regulator-max-microvolt = <3300000>;
            };
            ET5904LDO411:ET5904LDO411 {
                regulator-name = "ET5904LDO411";
                regulator-min-microvolt = <1200000>;
                regulator-max-microvolt = <3300000>;
            };
        };
   };
};

&odm {
    gpioldo_vda0: gpioldo_vda0 {
       compatible = "regulator-fixed";
       regulator-name = "gpioldo_vda0";
       regulator-min-microvolt = <1800000>;
       regulator-max-microvolt = <1800000>;
       gpio = <&pio 185 0x0>;
       enable-active-high;
    };

    vs2pmu: vs2pmu {
      compatible = "regulator-fixed";
      regulator-name = "vs2pmu";
      regulator-min-microvolt = <1800000>;
      regulator-max-microvolt = <1800000>;
      gpio = <&pio 122 0x0>;
      enable-active-high;
      regulator-always-on;
      regulator-boot-on;
    };

    ldoid11: ldoid11 {
      compatible = "regulator-fixed";
      regulator-name = "ldoid11";
      regulator-min-microvolt = <1800000>;
      regulator-max-microvolt = <1800000>;
      gpio = <&pio 78 0x0>;
      enable-active-low;
      regulator-always-on;
      regulator-boot-on;
    };

    ldoid7: ldoid7 {
      compatible = "regulator-fixed";
      regulator-name = "ldoid7";
      regulator-min-microvolt = <1800000>;
      regulator-max-microvolt = <1800000>;
      gpio = <&pio 6 0x0>;
      enable-active-low;
      regulator-always-on;
      regulator-boot-on;
    };

    gpioldo_vd3: gpioldo_vd3 {
       compatible = "regulator-fixed";
       regulator-name = "gpioldo_vd3";
       regulator-min-microvolt = <1800000>;
       regulator-max-microvolt = <1800000>;
       gpio = <&pio 184 0x0>;
       enable-active-high;
       regulator-boot-on;
    };

    gpioldo_rst1: gpioldo_rst1 {
       compatible = "regulator-fixed";
       regulator-name = "gpioldo_rst1";
       regulator-min-microvolt = <1800000>;
       regulator-max-microvolt = <1800000>;
       gpio = <&pio 116 0x0>;
       enable-active-high;
    };

    gpioldo_vd2: gpioldo_vd2 {
       compatible = "regulator-fixed";
       regulator-name = "gpioldo_vd2";
       regulator-min-microvolt = <1050000>;
       regulator-max-microvolt = <1050000>;
       gpio = <&pio 186 0x0>;
       enable-active-high;
       regulator-boot-on;
    };

    gpioldo_af0: gpioldo_af0 {
      compatible = "regulator-fixed";
      regulator-name = "gpioldo_af0";
      regulator-min-microvolt = <3300000>;
      regulator-max-microvolt = <3300000>;
      gpio = <&pio 177 0x0>;
      enable-active-high;
    };

    gpioldo_af1: gpioldo_af1 {
      compatible = "regulator-fixed";
      regulator-name = "gpioldo_af1";
      regulator-min-microvolt = <2800000>;
      regulator-max-microvolt = <2800000>;
      gpio = <&pio 178 0x0>;
      enable-active-high;
    };

    gpioldo_af2: gpioldo_af2 {
      compatible = "regulator-fixed";
      regulator-name = "gpioldo_af2";
      regulator-min-microvolt = <2800000>;
      regulator-max-microvolt = <2800000>;
      gpio = <&pio 128 0x0>;
      enable-active-high;
    };

    gpioldo_af3: gpioldo_af3 {
      compatible = "regulator-fixed";
      regulator-name = "gpioldo_af3";
      regulator-min-microvolt = <2800000>;
      regulator-max-microvolt = <2800000>;
      gpio = <&pio 179 0x0>;
      enable-active-high;
    };

};

&i2c6 {
	#address-cells = <1>;
	#size-cells = <0>;
	aw36515:aw36515@63 {
		compatible = "mediatek,aw36515";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x63>;
		#cooling-cells = <2>;
		status = "okay";
		flash@0{
			reg = <1>;
			type = <1>;
			ct = <0>;
			part = <0>;
			port {
				fl_core_0: endpoint {
					remote-endpoint = <&flashlight_0>;
				};
			};
		};
		flash@1{
			reg = <0>;
			type = <0>;
			ct = <0>;
			part = <0>;
			port {
				fl_core_1: endpoint {
					remote-endpoint = <&flashlight_1>;
				};
			};
		};
	};
};

&mtk_composite_v4l2_1 {
	#address-cells = <1>;
	#size-cells = <0>;
	port@0 {
		reg = <0>;
		flashlight_0: endpoint {
			remote-endpoint = <&fl_core_0>;
		};
	};
	port@1 {
		reg = <1>;
		flashlight_1: endpoint {
			remote-endpoint = <&fl_core_1>;
		};
	};
};


&thermal_zones {
	camera0: camera0 {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&sensor0>;
		trips {
			camera0_crit: camera0-crit {
				temperature = <120000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};
	camera1: camera1 {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&sensor1>;
		trips {
			camera1_crit: camera1-crit {
				temperature = <120000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};
	camera2: camera2 {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&sensor2>;
		trips {
			camera2_crit: camera2-crit {
				temperature = <120000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};
	camera3: camera3 {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&sensor3>;
		trips {
			camera3_crit: camera3-crit {
				temperature = <120000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};
};

