&i2c13 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;
	/*         compatible = "nfg,nfg1000_master"; */
	/*         status = "okay"; */
	/*         reg = <0x55>; */
	/*         bootmode = <&chosen>; */
	/*         tran_Q_max = <2990>; */
	/*         nfg1000_master_gpio = <&pio 146 0x00>; */
	/*         pinctrl-names = "i2c_scl_gpio_init", "i2c_sda_gpio_init"; */
	/*         pinctrl-0 = <&gpio_master_i2c_sclk_mode>; */
	/*         pinctrl-1 = <&gpio_master_i2c_sda_mode>; */
	/*         nfg1000_ad_data_len_m = <61440>; */
	/*         i2c_support_dma; */
	/* }; */
	bq27z561_master@55 {
		compatible = "ti,bq27z561_master";
		status = "okay";
		reg = <0x55>;
		bootmode = <&chosen>;
		tran_Q_max = <2755>;
		bq27z561_master_gpio = <&pio 88 0x00>;
		pinctrl-names = "i2c_scl_gpio_init", "i2c_sda_gpio_init";
		pinctrl-0 = <&gpio_master_i2c_sclk_mode>;
		pinctrl-1 = <&gpio_master_i2c_sda_mode>;
		i2c_support_dma;
	};
};

&i2c11 {
        #address-cells = <1>;
        #size-cells = <0>;

        clock-frequency = <100000>;
        /*         compatible = "nfg,nfg1000_slave"; */
        /*         status = "okay"; */
        /*         reg = <0x55>; */
        /*         bootmode = <&chosen>; */
        /*         tran_Q_max = <2660>; */
        /*         nfg1000_slave_gpio = <&pio 147 0x00>; */
        /*         pinctrl-names = "i2c_scl_gpio_init", "i2c_sda_gpio_init"; */
        /*         pinctrl-0 = <&gpio_slave_i2c_sclk_mode>; */
        /*         pinctrl-1 = <&gpio_slave_i2c_sda_mode>; */
        /*         nfg1000_ad_data_len_s = <61440>; */
        /*         i2c_support_dma; */
        /* }; */
        bq27z561_slave@55 {
                compatible = "ti,bq27z561_slave";
                status = "okay";
                reg = <0x55>;
                bootmode = <&chosen>;
                tran_Q_max = <2445>;
                /*bq27z561_slave_gpio = <&pio 147 0x00>;*/
                bq,batt_exio_en = <1>;
                pinctrl-names = "i2c_scl_gpio_init", "i2c_sda_gpio_init";
                pinctrl-0 = <&gpio_slave_i2c_sclk_mode>;
                pinctrl-1 = <&gpio_slave_i2c_sda_mode>;
                i2c_support_dma;
        };
};

&pio {
        gpio_slave_i2c_sclk_mode: gpio_slave_i2c_sclk_mode {
                pins_cmd_dat {
                        pinmux = <PINMUX_GPIO92__FUNC_SCL11>;
                        drive-strength = <4>;
                };
        };
        gpio_slave_i2c_sda_mode: gpio_slave_i2c_sda_mode {
                pins_cmd_dat {
                        pinmux = <PINMUX_GPIO93__FUNC_SDA11>;
                        drive-strength = <4>;
                };
        };

	gpio_master_i2c_sclk_mode: gpio_master_i2c_sclk_mode {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO104__FUNC_SCL13>;
			drive-strength = <4>;
		};
	};
	gpio_master_i2c_sda_mode: gpio_master_i2c_sda_mode {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO105__FUNC_SDA13>;
			drive-strength = <4>;
		};
	};
};

