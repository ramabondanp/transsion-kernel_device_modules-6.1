        ifod_threshold = <200>;
        rsw_min = <20>;
        ircmp_rbat = <40>;
        ircmp_vclamp = <0>;
        support_ta = "pd_adapter";
        allow_not_check_ta_status;
        vbat_threshold = <4350>;
	rechg_tbat_high = <44>;
	rechg_tbat_low = <12>;
	project_pwr_ratio = <70>;
	project_power = <100>;
	min_ita_gap = <10>;
	ita_stable_cnt = <20>;
	vol_diff_gap = <50>;
	cable_capability_level = <0 5000 6000 9000>;
	vol_diff_level = <1000 1000 1200 1500>;

	/*wireless charger*/
	wireless_curlmt = <2000 2000 2000 2200 2200>;
	wireless_sit_shift_curlmt = <1500>;
	/*Wireless EOC*/
	idvchg_wireless_term = <300>;
        /*0:2:1 or 4:2 cp
          1:4:2:1 cp*/
        wireless_en_dual= <0>;
	pe50_wireless_vta_init = <9000>;
	pe50_wireless_ita_init = <3000>;
        pe50_wireless_pdp_limit = <50>;
	pe50_vta_init = <5300>;
	pe50_ita_init = <3000>;
        pe50_default_vta_step = <20>;

        run_cp_cur = <0 1700 4250 9000>;
        run_cp_recovery_gap = <0 500 750 1000>;
        run_wls_cp_cur = <0 3000 6000 10000>;
        run_wls_cp_recovery_gap = <0 200 400 600>;

        /* support_6_2; */
        /* support_4_1; */
        /* support_4_2; */
        /* support_2_1; */
        /* support_1_1; */
        default_spec = <1>;
        support_spec =  <0 1 0 1 0>;
	vta_cap_min = <6800 6800 6800 6000 4000>;
        vta_cap_max = <30000 20000 20000 10500 10500>;
        ita_cap_min = <1000 1000 1000 1000 1000>;
        vbus_max_ovp = <33000 20800 20800 11000 11000>;

        /* battery step cv param */
        pe5_ffc_gap = <20 20 20 20 20 20>;

        step_ffc_level = <11>;
        step_ffc_level_0 = <10 15
                            4200  4200  4200  4200  4200 4500
                            6096 6096 6096 6096 6096 3556
                            254
			    (-1) (-1)
			    0>;
        step_ffc_level_1 = <15 35
                            4260  4300  4500  4530  4530 4530
                            20000 15240 10160 7620 7620 7620
                            1981
			    0 200
			    10 500>;
        step_ffc_level_2 = <35 45                            /* ffc temp */
                            4260  4300  4500  4530  4530 4530      /* ffc vbat */
                            20000 15240 10160 7620 7620 7620      /* ffc ibat */
                            2439		             /* ffc term */
			    0 200                          /* cycle cnt(write 0 if not supported long life) */
			    10 500>;                              /* rechg gap */
        step_ffc_level_3 = <15 35
                            4260  4300  4480  4510  4510 4510
                            20000 15240 10160 7620 7620 7620
                            1981
			    200 300
			    20 500>;
        step_ffc_level_4 = <35 45                            /* ffc temp */
                            4260  4300  4480  4510  4510 4510      /* ffc vbat */
                            20000 15240 10160 7620 7620 7620      /* ffc ibat */
                            2439		             /* ffc term */
			    200 300                       /* cycle cnt(write 0 if not supported long life) */
			    20 500>;  
        step_ffc_level_5 = <15 35
                            4260  4300  4460  4490  4490 4490
                            20000 15240 10160 7620 7620 7620
                            1981
			    300 500
			    40 500>;
        step_ffc_level_6 = <35 45                            /* ffc temp */
                            4260  4300  4460  4490  4490 4490     /* ffc vbat */
                            20000 15240 10160 7620 7620 7620      /* ffc ibat */
                            2439		             /* ffc term */
			    300 500                        /* cycle cnt(write 0 if not supported long life) */
			    40 500>;                             /* rechg gap */
        step_ffc_level_7 = <15 35
                            4260  4300  4400  4470  4470 4470
                            20000 15240 10160 7620 7620 7620
                            1981
			    500 1000
			    60 500>;
        step_ffc_level_8 = <35 45                            /* ffc temp */
                            4260  4300  4400  4470  4470 4470      /* ffc vbat */
                            20000 15240 10160 7620 7620 7620      /* ffc ibat */
                            2439		             /* ffc term */
			    500 1000                       /* cycle cnt(write 0 if not supported long life) */
			    60 500>;                             /* rechg gap */
        step_ffc_level_9 = <15 35
                            4260  4300  4390  4420  4420 4420
                            20000 17780 15240 10160 7620 7620
                            1981
			    1000 (-1)
			    110 500>;
        step_ffc_level_10 = <35 45                            /* ffc temp */
                            4260  4300  4390  4420  4420 4420      /* ffc vbat */
                            20000 15240 10160 7620 7620 7620      /* ffc ibat */
                            2439		             /* ffc term */
			    1000 (-1)                     /* cycle cnt(write 0 if not supported long life) */
			    110 500>;  

	support_long_life_recharger;

	/* dual battery  */
