&pe5{
	compatible = "tc_pe5";
	status = "okay";
	tc_chgtype = <&tc_chgtype>;
        polling_interval = <500>;
        ta_cv_ss_repeat_tmin = <25>;
        vbat_cv = <4530>;
        start_vbat_min = <3100>;
        start_vbat_max = <4480>;
        idvchg_term = <495>; // ibus 4 : 1
        idvchg_pps_term = <1200>;
        rcable_level = <180 280 380 480>;
        ita_level = <5000 4000 3500 3000>;
        idvchg_level_multi = <3000 5000 0 0>;
        idvchg_ss_init = <1000>;
        idvchg_ss_step = <250>;
