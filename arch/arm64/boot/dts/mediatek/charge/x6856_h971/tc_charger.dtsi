	/* master_batt_level = <2>; */
	/* master_batt_level_0 =  <(-20)    (0) */
	/*                         4500000  4500000  4500000  4500000  4500000  4500000 */
	/*                         900000   900000   900000   900000   900000   900000 */
	/*                         225000>; */

	/* master_batt_level_1 =  <0        50 */
