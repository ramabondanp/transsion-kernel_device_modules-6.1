/dts-v1/;
/plugin/;
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/mt6989-pinfunc.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/iio/mt635x-auxadc.h>

&chosen {
bootargs_ext = "";

};

&md_auxadc{
    io-channels = <&pmic_adc (ADC_PURES_OPEN_MASK | AUXADC_VIN1)>;
};
&pdc {
	pd-vbus-upper-bound = <9000000>;
};

&mtk_leds {
	compatible = "mediatek,disp-leds";

	backlight {
		led-mode = <4>;
		gate-enable = <0>;
		pwm-config = <0 1 0 0 0>;
		max-brightness = <511>;
		min-brightness = <0>;
		max-hw-brightness = <511>;
	};
};

&pio {
	mtkfb_pins_lcm_rst_out1_gpio: lcm_rst_out1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO230__FUNC_GPIO230>;
			slew-rate = <1>;
			output-high;
		};
	};

	mtkfb_pins_lcm_rst_out0_gpio: lcm_rst_out0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO230__FUNC_GPIO230>;
			slew-rate = <1>;
			output-low;
		};
	};

/*
	mtkfb_pins_lcm_sub_rst_out1_gpio: lcm_sub_rst_out1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO20__FUNC_GPIO20>;
			slew-rate = <1>;
			output-high;
		};
	};

	mtkfb_pins_lcm_sub_rst_out0_gpio: lcm_sub_rst_out0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO20__FUNC_GPIO20>;
			slew-rate = <1>;
			output-low;
		};
	};
*/

	mtkfb_pins_lcm_dsi_te: lcm_dsi_te {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO229__FUNC_DSI_TE>;
		};
	};

/*
	mtkfb_pins_lcm_dsi1_te: lcm_dsi1_te {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO14__FUNC_DSI2_TE>;
		};
	};
*/
};

&mtkfb {
/*
	pinctrl-names = "lcm_rst_out1_gpio", "lcm_rst_out0_gpio",
		"lcm_sub_rst_out1_gpio", "lcm_sub_rst_out0_gpio",
		"mode_te_te", "mode_te_te1";
*/
	pinctrl-names = "lcm_rst_out1_gpio", "lcm_rst_out0_gpio", "mode_te_te";
	pinctrl-0 = <&mtkfb_pins_lcm_rst_out1_gpio>;
	pinctrl-1 = <&mtkfb_pins_lcm_rst_out0_gpio>;
	pinctrl-2 = <&mtkfb_pins_lcm_dsi_te>;
/*
	pinctrl-2 = <&mtkfb_pins_lcm_sub_rst_out1_gpio>;
	pinctrl-3 = <&mtkfb_pins_lcm_sub_rst_out0_gpio>;
	pinctrl-4 = <&mtkfb_pins_lcm_dsi_te>;
	pinctrl-5 = <&mtkfb_pins_lcm_dsi1_te>;
*/

	status = "okay";
};

&dispsys_config {
/*
	pinctrl-names = "lcm_rst_out1_gpio", "lcm_rst_out0_gpio",
		"lcm_sub_rst_out1_gpio", "lcm_sub_rst_out0_gpio",
		"mode_te_te", "mode_te_te1";
*/
	pinctrl-names = "lcm_rst_out1_gpio", "lcm_rst_out0_gpio", "mode_te_te";
	pinctrl-0 = <&mtkfb_pins_lcm_rst_out1_gpio>;
	pinctrl-1 = <&mtkfb_pins_lcm_rst_out0_gpio>;
	pinctrl-2 = <&mtkfb_pins_lcm_dsi_te>;
/*
	pinctrl-2 = <&mtkfb_pins_lcm_sub_rst_out1_gpio>;
	pinctrl-3 = <&mtkfb_pins_lcm_sub_rst_out0_gpio>;
	pinctrl-4 = <&mtkfb_pins_lcm_dsi_te>;
	pinctrl-5 = <&mtkfb_pins_lcm_dsi1_te>;
*/
	status = "okay";
};

&i2c1 {
	#address-cells = <1>;
	#size-cells = <0>;

	dio8018@35 {
	    compatible = "tran,dio8018";
	    reg = <0x35>;
	    regulators {
	        DIO8018LDO11:DIO8018LDO11 {
	            regulator-name = "DIO8018LDO11";
	            regulator-min-microvolt = <800000>;
	            regulator-max-microvolt = <1800000>;
	        };
	        DIO8018LDO21:DIO8018LDO21 {
	            regulator-name = "DIO8018LDO21";
	            regulator-min-microvolt = <800000>;
	            regulator-max-microvolt = <1800000>;
	        };
	        DIO8018LDO31:DIO8018LDO31 {
	            regulator-name = "DIO8018LDO31";
	            regulator-min-microvolt = <1500000>;
	            regulator-max-microvolt = <3900000>;
	        };
	        DIO8018LDO41:DIO8018LDO41 {
	            regulator-name = "DIO8018LDO41";
	            regulator-min-microvolt = <1500000>;
	            regulator-max-microvolt = <3900000>;
	        };
	        DIO8018LDO51:DIO8018LDO51 {
	            regulator-name = "DIO8018LDO51";
	            regulator-min-microvolt = <1500000>;
	            regulator-max-microvolt = <3900000>;
	        };
	        DIO8018LDO61:DIO8018LDO61 {
	            regulator-name = "DIO8018LDO61";
	            regulator-min-microvolt = <1500000>;
	            regulator-max-microvolt = <3900000>;
	        };
	        DIO8018LDO71:DIO8018LDO71 {
	            regulator-name = "DIO8018LDO71";
	            regulator-min-microvolt = <1500000>;
	            regulator-max-microvolt = <3900000>;
	        };
	    };
	};
};

&dsi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	possible_crtcs = <3>;
	panel1@0 {
		compatible = "nt37900,wqhd,dsi,cmd,csot,120hz,d9300";
		reg = <0>;
		vddi-supply = <&DIO8018LDO31>; //1.8V
		dvdd-supply = <&DIO8018LDO11>; //1.35V
		vci-supply = <&DIO8018LDO51>; //3.0V
		reset-gpios = <&pio 230 0>;
		te-gpio = <&pio 229 0>;
		pinctrl-names = "default";
		port {
			panel1_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
	ports {
		port {
			dsi_out: endpoint {
				remote-endpoint = <&panel1_in>;
			};
		};
	};
};

