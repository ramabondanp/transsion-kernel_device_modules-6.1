&spi1 {
        fingerprint@0 {
        compatible = "tran_fp";
        reg = <0>;
        spi-max-frequency = <27000000>;
        interrupt-parent = <&pio>;
        interrupts = <5 1 5 0>;
        debounce = <5 0>;
        irq-gpio = <5>;
        irq-gpio-std = <&pio 5 0x0>;
        reset-gpio = <197>;
        reset-gpio-std = <&pio 197 0x0>;
        vmch-supply = <&mt6373_vfp>;
        goodix;
        pinctrl-names ="tran_fp_default",
        "tran_fp_pin_irq",
        "tran_fp_irq_pull_down",
        "tran_fp_reset_high",
        "tran_fp_reset_low",
        "tran_fp_spi_default";
        pinctrl-0 = <&fingerprint_default>;
        pinctrl-1 = <&fingerprint_eint>;
        pinctrl-2 = <&fingerprint_eint_pull_down>;
        pinctrl-3 = <&fingerprint_rst_one>;
        pinctrl-4 = <&fingerprint_rst_zero>;
        pinctrl-5 = <&fingerprint_spi_default>;
        status = "okay";
        };
};
&pio {
    fingerprint_default: fingerprint_default {
        };
    fingerprint_eint: gpio5_eint {
    pins_cmd_dat {
        pinmux = <PINMUX_GPIO5__FUNC_GPIO5>;
        slew-rate = <0>;
        bias-disable;
        };
    };
    fingerprint_eint_pull_down: gpio5_eint_pull_down {
    pins_cmd_dat {
        pinmux = <PINMUX_GPIO5__FUNC_GPIO5>;
        slew-rate = <0>;
        bias-pull-down = <00>;
        output-low;
        };
    };
    fingerprint_rst_one: rst_out_one {
    pins_cmd_dat {
        pinmux = <PINMUX_GPIO197__FUNC_GPIO197>;
        slew-rate = <1>;
        bias-disable;
        output-high;
        };
    };
    fingerprint_rst_zero: rst_out_zero {
    pins_cmd_dat {
        pinmux = <PINMUX_GPIO197__FUNC_GPIO197>;
        slew-rate = <1>;
        bias-disable;
        output-low;
        };
    };
    fingerprint_spi_default: spimode_default_fp {
    pins_cmd_dat {
        pinmux = <PINMUX_GPIO190__FUNC_SPI1_MI>,
        <PINMUX_GPIO188__FUNC_SPI1_CSB>,
        <PINMUX_GPIO189__FUNC_SPI1_MO>,
        <PINMUX_GPIO187__FUNC_SPI1_CLK>;
        drive-strength = <3>;
        };
    };
};

&connfem {
	/* Support Wifi & BT ePA/eLNA FEM on customer load */
	epa-elna {
		parts = <&qm42639 &qm45639>;
		common {
			flags-0 {
				rx-mode = [35];
				fe-ant-cnt = [82];
				fe-main-bt-share-lp2g = [81];
				fe-conn-spdt = [8F];
				fe-reserved = [86];
			};
		};
		wifi {
			flags-0 {
				epa-option = [aa];
				/* open-loop; */
			};
		};

		bt {
			flags-0 {
				/* choose one of: epa-elna/epa/elna/bypass */
				epa-elna;
			};
		};
	};
};
