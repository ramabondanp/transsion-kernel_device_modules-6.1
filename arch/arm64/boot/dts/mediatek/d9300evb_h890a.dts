&i2c6 {
	aw883xx_smartpa_0: aw883xx@34 {
		compatible = "awinic,aw883xx_smartpa";
		#sound-dai-cells = <0>;
		reg = <0x34>;
		#reset-gpio = <&pio 140 0x0>;
		#irq-gpio = <&pio 37 0x0>;
		sync-load = <1>;
		sound-channel = <0>;
		re-min = <1000>;
		re-max= <40000>;
		status = "okay";
	};
	aw883xx_smartpa_1: aw883xx@35 {
		compatible = "awinic,aw883xx_smartpa";
		#sound-dai-cells = <0>;
		reg = <0x35>;
		#reset-gpio = <&pio 139 0x0>;
		#irq-gpio = <&pio 19 0x0>;
		sync-load = <1>;
		sound-channel = <1>;
		re-min = <1000>;
		re-max= <40000>;
		status = "okay";
	};
};

&i2c3 {
	was4783: was4783@42 {
		status = "ok";
		compatible = "mediatek,was4783-audioswitch";
		reg = <0x42>;
	};
};

&i2c3 {
       clock-frequency = <400000>;
       nfc_nxp@29 {
               compatible = "nxp,pn544";
               reg = <0x29>;
               nxp,pn544-irq = <&pio 154 0x0>;
               nxp,pn544-ven = <&pio 19 0x0>;
       };
};

&sound {
	mediatek,spk-i2s = <21 20>;
	mediatek,speaker-codec {
		sound-dai = <&aw883xx_smartpa_0 &aw883xx_smartpa_1>;
	};
};

&wifi {
	flavor-bin = "dx3";
};

&bt {
	flavor-bin = "dx3";
};

&mt6363_vbuck5 {
	regulator-always-on;
};

&mt6363_vbuck6 {
	regulator-always-on;
