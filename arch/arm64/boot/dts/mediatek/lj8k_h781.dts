&dsi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	panel1@0 {
		compatible = "nt37703a,fhdp,dsi,vdo,tm,tm,144hz,lj8k";
		reg = <0>;
		doze_backlight = <3 5 7 29>;
		vddi-gpios = <&pio 12 0>;
		dvdd-supply = <&ET5904LDO27>;
		vci-gpios = <&pio 56 0>;
		reset-gpios = <&pio 90 0>;
		pinctrl-names = "default";
		port {
			panel_in1: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	ports {
		port {
			dsi_out: endpoint {
				remote-endpoint = <&panel_in1>;
			};
		};
	};
};
&audio_sram {
	reg = <0 0x11059000 0 0xc000>;
	mode-size = <0xc000 0x11300>;
};

&audio_xhci_sram {
	reg = <0 0x11065000 0 0x3900>;
	mode-size = <0x3900>;
	afe-reserved;
};

/* usb typec mux start */
&mt6375_typec {
	//tcpc,en-fod;
	pd-data {
		/*
		 * Fixed 5V, 500 mA <0x00019032>
		 * Fixed 5V, 1A <0x00019064>
		 * Fixed 5V, 1.5A <0x00019096>
		 * Fixed 5V, 2A <0x000190c8>
		 * Fixed 5V, 3A <0x0001912c>
		 * Fixed 9V, 500 mA <0x0002d032>
		 * Fixed 9V, 1A <0x0002d064>
		 * Fixed 9V, 2A <0x0002d0c8>
		 * Fixed 9V, 3A <0x0002d12c>
		 * Variable 5-9V, 1A <0x8642d064>
		 * Variable 5-9V, 2A <0x8642d0c8>
		 * Variable 5-9V, 3A <0x8642d12c>
		 * PPS 3V~5.9V, 3A <0xC0761E3C>
		 */
		pd,source-pdo-size = <2>;
		pd,source-pdo-data = <0x00019032 0x000190c8>; /* 1:5V,500mA  2:5V,2000 mA */
	};
};

&u2port0 {
        mediatek,eye-vrt = <0x4>;
        mediatek,eye-term = <0x7>;
        mediatek,rev6 = <0x2>;
        mediatek,eye-vrt-host = <0x4>;
        mediatek,eye-term-host = <0x7>;
        mediatek,rev6-host = <0x2>;
};

&pdc {
	pd-vbus-upper-bound = <9000000>;
};

&irtx_pwm {
	pwm_ch = <0>;
	status = "okay";
};

&tran_sensor_cust {
    /*lcm info for sensor start*/
    /*als sensor support state*/
    un_als_support = <1 0 0 0>;/*ML MSL SL SSL*/
    /*main sensor:ML*/
    ml_lcm_info = <836 47 58 58>;/*offset_x, offset_y, clip_w, clip_h*/
    extra_ml_lcm_info = <844 49 46 46 80 20>; /*IC感光区起始坐标X IC感光区起始坐标Y IC宽 IC高  IC内占比 IC外占比*/
    /*main sub als lcm info:MSL*/
    /*lcm info for sensor end*/
	ml_nv_info = <1 1 1>; /*vendortype:SensorTek,  algotype:Cutout, version:V1_0_0*/
	nv_restore_time = <3>;
};

&consys {
	hwid-node = <92>;
	adie-sku = <1 0>;
};

&thermal_zones {
	sub_ntc: sub_ntc {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&tboard_thermistor4>;

		trips {
			sub_ntc_crit: sub-ntc-crit {
				temperature = <119000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};
	tran_one_ntc: tran_one_ntc {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&tboard_thermistor5>;

		trips {
			tran_one_ntc_crit: tran-one-ntc-crit {
				temperature = <119000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};
	tran_two_ntc: tran_two_ntc {
		polling-delay = <0>; /* milliseconds */
		polling-delay-passive = <0>; /* milliseconds */
		thermal-sensors = <&tboard_thermistor6>;

		trips {
			tran_two_ntc_crit: tran-two-ntc-crit {
				temperature = <119000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};
};

&md_power_throttling {
	compatible = "mediatek,md-power-throttling";

	lbat-max-level = <3>;
	lbat-reduce-tx-lv1 = <0>;
	lbat-reduce-tx-lv2 = <0>;
	lbat-reduce-tx-lv3 = <0>;

	oc-max-level = <2>;
	oc-reduce-tx-lv1 = <0>;
	oc-reduce-tx-lv2 = <0>;

	soc-max-level = <1>;
	soc-reduce-tx-lv1 = <0>;
};

&u2port0 {
        mediatek,eye-vrt = <0x4>;
        mediatek,eye-term = <0x7>;
        mediatek,rev6 = <0x2>;
        mediatek,eye-vrt-host = <0x4>;
        mediatek,eye-term-host = <0x7>;
        mediatek,rev6-host = <0x2>;
};

